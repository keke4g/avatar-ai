/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.secrets/

# vercel
.vercel
supabase/.temp/

# Firebase private service-account keys (never commit these)
supabase/functions/**/service-account*.json

# typescript
*.tsbuildinfo
next-env.d.ts

