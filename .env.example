# AuraSwap Cloud Backend Environment Config Template
# Duplicate this file as '.env.local' and populate it with your Supabase credentials

# 1. Supabase Client SDK Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anonymous-anon-key-token-here

# 2. Dynamic Backend Switch Controller
# Set to 'true' to redirect authentication and data pipelines to Supabase.
# Set to 'false' to preserve the offline localStorage and mock data engine.
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_APP_URL=https://avatar-ai-4hcg.vercel.app

# 3. Eterna voice engines (server-only secrets)
# ElevenLabs Free: Multilingual v2 + Sarah by default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional free alternative: Azure Speech F0 + es-MX-DaliaNeural.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 4. Google Maps (browser-public key; restrict it by HTTP referrer in Google Cloud)
# Enable Maps JavaScript API, Places API (New) and Routes API for this project.
REACT_APP_GOOGLE_MAPS_API_KEY=
