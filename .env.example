# AuraSwap Cloud Backend Environment Config Template
# Duplicate this file as '.env.local' and populate it with your Supabase credentials
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0 in any AuraSwap environment.

# 1. Supabase Client SDK Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anonymous-anon-key-token-here
# Server-only. Required by the scheduled valuation document ingestor; never
# expose this value through NEXT_PUBLIC_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private market-comparable worker. This identifier is sent only by the
# standalone collector and never by browser code.
MARKET_SCRAPER_USER_AGENT=TowersMexicoMarketResearchBot/1.0 (+https://towersmexico.com)

# Authorized comparable providers. Never enable a provider merely because an
# API key exists: the referenced owner/contract must explicitly permit Towers
# México to use the inventory for statistical market estimates.
EASYBROKER_API_KEY=
EASYBROKER_SOURCE_CODE=easybroker-owner-authorized
EASYBROKER_AUTHORIZATION_REFERENCE=
EASYBROKER_AVM_USE_AUTHORIZED=false

# Preferred Mercado Libre API connector. The separate RESEARCH_ONLY browser
# adapter stops on authentication/CAPTCHA and never uses bypass features.
MERCADOLIBRE_ACCESS_TOKEN=
MERCADOLIBRE_AVM_CONTRACT_ID=
MERCADOLIBRE_AVM_USE_AUTHORIZED=false
MERCADOLIBRE_SEARCH_BBOX=
MERCADOLIBRE_CATEGORY_IDS=
MERCADOLIBRE_SEARCH_CITY=
MERCADOLIBRE_SEARCH_STATE=

# 2. Backend provider and canonical public URL
# Always set the provider explicitly so development, staging and production
# exercise the same persistence path. Use "memory" only for isolated demos.
NEXT_PUBLIC_PROPERTY_PROVIDER=supabase
# Demo inventory is available only in local memory mode and is always excluded
# from the production public catalog.
NEXT_PUBLIC_SHOW_DEMO_PROPERTIES=true
NEXT_PUBLIC_APP_URL=https://towersmexico.com
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacidad@your-domain.example

# Google OAuth credentials are configured in Google Cloud and in the
# Supabase Auth provider. They are intentionally not shipped to the browser or
# duplicated in this application's environment variables.

# 3. Eterna voice engine (server-only secret)
# Fish Audio is primary; the browser voice is the automatic no-key fallback.
FISH_API_KEY=
# Optional: use a private/licensed Fish voice and a paid official model.
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
# low (default), balanced or normal.
FISH_AUDIO_LATENCY=low

# Used server-side to embed official valuation documents for hybrid RAG search.
GOOGLE_API_KEY=

# 4. Google Maps (browser-public key; restrict it by HTTP referrer in Google Cloud)
# Enable Maps JavaScript API, Places API (New) and Routes API for this project.
REACT_APP_GOOGLE_MAPS_API_KEY=
