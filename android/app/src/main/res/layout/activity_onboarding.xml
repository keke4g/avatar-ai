<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/onboarding_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="yes"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/onboarding_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="8dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/onboarding_progress"
                android:layout_width="wrap_content"
                android:layout_height="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/onboarding_progress_1"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/onboarding_progress_active" />

                <View
                    android:id="@+id/onboarding_progress_2"
                    android:layout_width="5dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/onboarding_progress_inactive" />

                <View
                    android:id="@+id/onboarding_progress_3"
                    android:layout_width="5dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/onboarding_progress_inactive" />

                <View
                    android:id="@+id/onboarding_progress_4"
                    android:layout_width="5dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/onboarding_progress_inactive" />
            </LinearLayout>

            <TextView
                android:id="@+id/onboarding_permission_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/onboarding_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/onboarding_primary_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/onboarding_button_primary"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/next_step"
                android:textAllCaps="false"
                android:textColor="@color/onboarding_white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/onboarding_secondary_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:elevation="0dp"
                android:fontFamily="sans-serif"
                android:stateListAnimator="@null"
                android:text="@string/skip_onboarding"
                android:textAllCaps="false"
                android:textColor="@color/onboarding_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
